џџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџотцџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџџќќ§їјћѓєј№ђїэяѕьюѕьюєэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэюѕэ